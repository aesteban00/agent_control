# ===========================================
# Agent Control - Environment Variables
# ===========================================
#
# Cargado por:
#   - mcp_proxy_server.py (load_dotenv) y propagado al MCP oficial
#   - mcp_client.py (MONGODB_URI -> MDB_MCP_CONNECTION_STRING)
#   - docker-compose.yml (env_file)
#
# Doc oficial de las opciones MDB_MCP_*:
# https://www.mongodb.com/docs/mcp-server/configuration/options/
# ===========================================

# === Requerido ===
# Connection string de MongoDB Atlas
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority

# === Opcional: guardrails nativos del MongoDB MCP Server ===
# Solo lectura (bloquea insert/update/delete/drop)
MDB_MCP_READ_ONLY=true

# Rechaza queries que requieren collection scan (sin índice)
MDB_MCP_INDEX_CHECK=true

# Timeout máximo (ms) para find/aggregate/count
MDB_MCP_MAX_TIME_M_S=5000

# Desactivar telemetría
MDB_MCP_TELEMETRY=disabled

# Tools / categorías a desactivar (CSV)
# MDB_MCP_DISABLED_TOOLS=delete,drop-collection,drop-database,atlas
